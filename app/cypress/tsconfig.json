{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "baseUrl": "..",

    "paths": {
      "@/*": ["src/*"]
    },

    "types": [
      "cypress",
      "node"
    ],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },

  "include": [
    "**/*.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../cypress.config.ts"
  ]
}